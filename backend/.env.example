# Django Settings (production template — copy to .env and fill secrets locally)
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=your-secret-key-here

# Database Configuration (Supabase pooler — transaction mode)
DB_ENGINE=postgresql
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_NAME=postgres
DB_PORT=6543
DB_USER=postgres
DB_PASSWORD=your-supabase-password

# Required for pooler when DB_USER=postgres (Supabase → Settings → General → Reference ID)
DB_PROJECT_REF=your-project-ref

# Frontend URL
FRONTEND_URL=https://dietplanner.vercel.app

# Allowed Hosts (replace with your actual Render URL)
ALLOWED_HOSTS=your-render-app.onrender.com,localhost

# YouTube Data API Key (for yoga/meditation video search)
# Get your API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key-here

# Email Configuration (Gmail SMTP)
# 1. Turn ON 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and generated App Password below:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL="DietPlanner" <your-email@gmail.com>

